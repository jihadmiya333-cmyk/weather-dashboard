<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#101827">
  <title>Skycast — Weather Dashboard</title>
  <style>
    :root {
      --bg: #0b1220;
      --panel: rgba(21, 33, 54, .82);
      --panel-light: rgba(255,255,255,.08);
      --text: #f4f8ff;
      --muted: #9caecc;
      --accent: #72d8ff;
      --accent-2: #a78bfa;
      --danger: #ff9b9b;
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    * { box-sizing: border-box; }
    body {
      margin: 0;
      min-height: 100vh;
      color: var(--text);
      background: radial-gradient(circle at 15% 0%, #203b63 0, transparent 35%), var(--bg);
    }
    button, input { font: inherit; }
    button { cursor: pointer; }
    .app { width: min(1120px, 100%); margin: auto; padding: 28px 20px 44px; }
    header { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-bottom: 28px; }
    .brand { display: flex; align-items: center; gap: 12px; }
    .logo { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 14px; background: linear-gradient(135deg, var(--accent), var(--accent-2)); font-size: 24px; }
    h1, h2, p { margin: 0; }
    h1 { font-size: clamp(1.35rem, 4vw, 1.8rem); }
    .eyebrow { color: var(--muted); font-size: .78rem; letter-spacing: .12em; text-transform: uppercase; }
    .search { display: flex; width: min(430px, 100%); gap: 8px; }
    .search input { min-width: 0; flex: 1; color: var(--text); background: var(--panel-light); border: 1px solid rgba(255,255,255,.14); border-radius: 10px; padding: 12px 14px; outline: none; }
    .search input:focus { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(114,216,255,.15); }
    .button { border: 0; border-radius: 10px; padding: 11px 15px; color: #07111f; background: var(--accent); font-weight: 700; }
    .button.secondary { color: var(--text); background: var(--panel-light); border: 1px solid rgba(255,255,255,.12); }
    .toolbar { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 16px; }
    .unit-toggle { display: flex; overflow: hidden; border: 1px solid rgba(255,255,255,.13); border-radius: 9px; }
    .unit-toggle button { border: 0; padding: 7px 11px; color: var(--muted); background: transparent; }
    .unit-toggle button.active { color: #07111f; background: var(--accent); font-weight: 700; }
    .status { min-height: 24px; color: var(--muted); font-size: .92rem; }
    .status.error { color: var(--danger); }
    .dashboard { display: grid; grid-template-columns: 1.3fr .7fr; gap: 16px; }
    .card { background: var(--panel); border: 1px solid rgba(255,255,255,.1); border-radius: 18px; box-shadow: 0 18px 50px rgba(0,0,0,.18); backdrop-filter: blur(14px); }
    .current { padding: 28px; min-height: 290px; display: flex; flex-direction: column; justify-content: space-between; background: linear-gradient(135deg, rgba(42,74,117,.8), rgba(21,33,54,.8)); }
    .location { font-size: clamp(1.5rem, 5vw, 2.35rem); margin-top: 6px; }
    .date { color: var(--muted); margin-top: 5px; }
    .temperature { display: flex; align-items: center; gap: 18px; margin-top: 28px; }
    .weather-icon { font-size: clamp(4rem, 10vw, 6rem); line-height: 1; }
    .temp { font-size: clamp(4rem, 11vw, 6.6rem); line-height: .9; letter-spacing: -.08em; }
    .condition { color: var(--accent); font-size: 1.1rem; text-transform: capitalize; }
    .details { padding: 22px; }
    .details h2, .forecast h2 { font-size: 1rem; margin-bottom: 18px; }
    .metric-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; }
    .metric { padding: 15px; border-radius: 12px; background: var(--panel-light); }
    .metric-label { color: var(--muted); font-size: .78rem; }
    .metric-value { margin-top: 5px; font-size: 1.15rem; font-weight: 700; }
    .forecast { grid-column: 1 / -1; padding: 22px; }
    .forecast-list { display: grid; grid-template-columns: repeat(7, 1fr); gap: 10px; }
    .forecast-day { padding: 15px 8px; text-align: center; border-radius: 12px; background: var(--panel-light); }
    .forecast-day strong { display: block; font-size: .85rem; }
    .forecast-day .small-icon { display: block; margin: 12px 0; font-size: 1.7rem; }
    .forecast-day span { color: var(--muted); font-size: .8rem; }
    .loading { opacity: .6; pointer-events: none; }
    footer { margin-top: 22px; color: var(--muted); text-align: center; font-size: .8rem; }
    @media (max-width: 760px) {
      header, .toolbar { align-items: stretch; flex-direction: column; }
      .search { width: 100%; }
      .dashboard { grid-template-columns: 1fr; }
      .forecast { grid-column: auto; overflow-x: auto; }
      .forecast-list { min-width: 650px; }
    }
  </style>
</head>
<body>
  <main class="app">
    <header>
      <div class="brand">
        <div class="logo" aria-hidden="true">☀</div>
        <div><p class="eyebrow">Live weather</p><h1>Skycast Dashboard</h1></div>
      </div>
      <form class="search" id="searchForm" role="search">
        <label class="sr-only" for="cityInput">Search for a city</label>
        <input id="cityInput" type="search" placeholder="Search city, e.g. Dhaka" autocomplete="off" required>
        <button class="button" type="submit">Search</button>
      </form>
    </header>

    <div class="toolbar">
      <p id="status" class="status" aria-live="polite">Search for a city to see the latest forecast.</p>
      <div class="unit-toggle" aria-label="Temperature unit">
        <button type="button" data-unit="celsius" class="active">°C</button>
        <button type="button" data-unit="fahrenheit">°F</button>
      </div>
    </div>

    <section id="dashboard" class="dashboard" aria-live="polite" hidden>
      <article class="card current">
        <div><p class="eyebrow">Current conditions</p><h2 id="location" class="location"></h2><p id="date" class="date"></p></div>
        <div class="temperature"><span id="currentIcon" class="weather-icon" aria-hidden="true">☀️</span><div><div id="temperature" class="temp"></div><div id="condition" class="condition"></div></div></div>
      </article>
      <article class="card details"><h2>Today's details</h2><div class="metric-grid">
        <div class="metric"><div class="metric-label">Feels like</div><div id="feelsLike" class="metric-value">—</div></div>
        <div class="metric"><div class="metric-label">Humidity</div><div id="humidity" class="metric-value">—</div></div>
        <div class="metric"><div class="metric-label">Wind</div><div id="wind" class="metric-value">—</div></div>
        <div class="metric"><div class="metric-label">Precipitation</div><div id="precipitation" class="metric-value">—</div></div>
      </div></article>
      <article class="card forecast"><h2>7-day forecast</h2><div id="forecastList" class="forecast-list"></div></article>
    </section>
    <footer>Weather data provided by <a href="https://open-meteo.com/" target="_blank" rel="noopener">Open-Meteo</a>. No API key required.</footer>
  </main>

  <script>
    const $ = (id) => document.getElementById(id);
    const state = { unit: 'celsius', weather: null };
    const weatherCodes = {
      0: ['Clear sky', '☀️'], 1: ['Mainly clear', '🌤️'], 2: ['Partly cloudy', '⛅'], 3: ['Overcast', '☁️'],
      45: ['Fog', '🌫️'], 48: ['Rime fog', '🌫️'], 51: ['Light drizzle', '🌦️'], 53: ['Drizzle', '🌦️'], 55: ['Heavy drizzle', '🌧️'],
      61: ['Light rain', '🌦️'], 63: ['Rain', '🌧️'], 65: ['Heavy rain', '🌧️'], 71: ['Light snow', '🌨️'], 73: ['Snow', '❄️'], 75: ['Heavy snow', '❄️'],
      80: ['Rain showers', '🌦️'], 81: ['Rain showers', '🌧️'], 82: ['Heavy showers', '⛈️'], 95: ['Thunderstorm', '⛈️'], 96: ['Thunderstorm with hail', '⛈️'], 99: ['Thunderstorm with hail', '⛈️']
    };
    const formatTemp = (value) => `${Math.round(state.unit === 'celsius' ? value : value * 9 / 5 + 32)}°`;
    const getWeatherInfo = (code) => weatherCodes[code] || ['Unknown', '🌡️'];
    const setStatus = (message, error = false) => { $('status').textContent = message; $('status').className = `status${error ? ' error' : ''}`; };

    async function searchCity(name) {
      const response = await fetch(`https://geocoding-api.open-meteo.com/v1/search?name=${encodeURIComponent(name)}&count=1&language=en&format=json`);
      if (!response.ok) throw new Error('Unable to search for that city.');
      const result = await response.json();
      if (!result.results?.length) throw new Error(`No location found for “${name}”.`);
      return result.results[0];
    }

    async function fetchWeather(place) {
      const params = new URLSearchParams({ latitude: place.latitude, longitude: place.longitude, timezone: 'auto', forecast_days: 7,
        current: 'temperature_2m,relative_humidity_2m,apparent_temperature,is_day,precipitation,weather_code,wind_speed_10m',
        daily: 'weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max' });
      const response = await fetch(`https://api.open-meteo.com/v1/forecast?${params}`);
      if (!response.ok) throw new Error('Weather data is temporarily unavailable.');
      return response.json();
    }

    function render(place, data) {
      state.weather = { place, data };
      const current = data.current;
      const [description, icon] = getWeatherInfo(current.weather_code);
      $('dashboard').hidden = false;
      $('location').textContent = `${place.name}${place.country_code ? `, ${place.country_code}` : ''}`;
      $('date').textContent = new Date(current.time).toLocaleString([], { weekday: 'long', month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });
      $('currentIcon').textContent = icon;
      $('temperature').textContent = formatTemp(current.temperature_2m);
      $('condition').textContent = description;
      $('feelsLike').textContent = formatTemp(current.apparent_temperature);
      $('humidity').textContent = `${current.relative_humidity_2m}%`;
      $('wind').textContent = `${Math.round(current.wind_speed_10m)} km/h`;
      $('precipitation').textContent = `${current.precipitation} mm`;
      $('forecastList').innerHTML = data.daily.time.map((day, index) => {
        const [label, dayIcon] = getWeatherInfo(data.daily.weather_code[index]);
        const date = new Date(`${day}T12:00:00`);
        return `<div class="forecast-day" title="${label}"><strong>${index === 0 ? 'Today' : date.toLocaleDateString([], { weekday: 'short' })}</strong><span class="small-icon" aria-hidden="true">${dayIcon}</span><b>${formatTemp(data.daily.temperature_2m_max[index])}</b><br><span>${formatTemp(data.daily.temperature_2m_min[index])}</span><br><span>${data.daily.precipitation_probability_max[index]}% rain</span></div>`;
      }).join('');
    }

    async function loadCity(name) {
      document.body.classList.add('loading'); setStatus(`Loading weather for ${name}…`);
      try { const place = await searchCity(name); const data = await fetchWeather(place); render(place, data); setStatus(`Updated ${new Date().toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' })}`); }
      catch (error) { setStatus(error.message, true); }
      finally { document.body.classList.remove('loading'); }
    }

    $('searchForm').addEventListener('submit', (event) => { event.preventDefault(); loadCity($('cityInput').value.trim()); });
    document.querySelectorAll('[data-unit]').forEach((button) => button.addEventListener('click', () => {
      state.unit = button.dataset.unit; document.querySelectorAll('[data-unit]').forEach((item) => item.classList.toggle('active', item === button));
      if (state.weather) render(state.weather.place, state.weather.data);
    }));
    loadCity('Dhaka');
  </script>
</body>
</html>
